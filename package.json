{
  "name": "mergechain",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "MergeChain — a Chrome extension that adds merge dependencies to GitHub pull requests: block a PR's merge until the PRs it depends on land.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "check:skill-sync": "node scripts/check-skill-sync.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && cd dist && zip -r ../mergechain.zip . -x '*.map' && cd .."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-functional": "^10.0.1",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
